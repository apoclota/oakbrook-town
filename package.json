{
  "name": "dsh-town-life",
  "version": "1.11.1",
  "private": true,
  "type": "module",
  "description": "橡溪镇主角生活线：可从 DSH 简介和设置进入实时地图，查看地点、商店、货币与 NPC，并进行旅行、购物、对话、工作和小屋自由装修；与主角共享本地状态。",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "locale", "docs", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["slots"], "external": ["react"] }
  },
  "scripts": { "town": "node lib/serve.mjs" }
}
